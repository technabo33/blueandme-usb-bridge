[Unit]
Description=BlueAndMe USB Bluetooth bridge v0.5.6 (community)
After=local-fs.target bluetooth.service bluealsa.service
Wants=bluetooth.service bluealsa.service

[Service]
Type=simple
EnvironmentFile=-/etc/default/blueandme-bt
Environment=BM_LOG_DIR=/run/blueandme
RuntimeDirectory=blueandme
RuntimeDirectoryMode=0755
ExecStart=/opt/blueandme-bridge/start_bt_v056.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillMode=control-group

[Install]
WantedBy=multi-user.target
